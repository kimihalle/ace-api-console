# Same-origin stack entry used by the Vite dev proxy.
NEW_API_TARGET=http://127.0.0.1:8088

# Leave empty when the frontend and New API share an origin/reverse proxy.
VITE_NEW_API_BASE_URL=

# New API native web console. Defaults to the same origin at /users.
VITE_NEW_API_CONSOLE_URL=

# Linux/Baota production only. Use an HTTPS origin without a path or trailing slash.
# Generate each secret separately with: openssl rand -hex 32
SITE_URL=
SESSION_SECRET=
CRYPTO_SECRET=

# Database: leave empty for SQLite; set a DSN to use an existing MySQL database.
# Example only: replace database_user, database_password and database_name locally.
# Use single quotes around a real DSN to preserve literal dollar signs.
# SQL_DSN='database_user:database_password@tcp(host.docker.internal:3306)/database_name?charset=utf8mb4&parseTime=true&loc=Local'
SQL_DSN=

# Optional separate log database. Empty means logs use the main database.
LOG_SQL_DSN=
